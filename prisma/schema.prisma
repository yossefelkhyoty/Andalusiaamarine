// ANDALUSIA MARINE - DB SCHEMA V2.0
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Project {
  id              Int      @id @default(autoincrement())
  category        String
  isHidden        Boolean  @default(false)
  title_en        String
  title_ar        String
  orange_label_en String?
  orange_label_ar String?
  desc_en         String?
  desc_ar         String?
  media_path      String
  media_type      String   @default("image")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
